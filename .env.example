# ------------------------------------------------------------------
# International Road Services – Libya · environment configuration
# Copy to /etc/irs-road/irs-road.env (production) or .env (local),
# then: chmod 640 and chown root:irsroad. NEVER commit the real file.
# ------------------------------------------------------------------

# development | production   (testing is used only by pytest)
FLASK_CONFIG=production
FLASK_APP=wsgi.py

# python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=change-me

# MariaDB — dedicated user with privileges on this database ONLY (never root)
# The MariaDB account is irs_app@127.0.0.1 → use 127.0.0.1 (not "localhost")
DATABASE_URL="mysql+pymysql://irs_app:CHANGE_ME_STRONG_PASSWORD@127.0.0.1/irs_road?charset=utf8mb4"
# Unix socket alternative (no TCP):
# DATABASE_URL="mysql+pymysql://irs_app:PASSWORD@localhost/irs_road?unix_socket=/run/mysqld/mysqld.sock&charset=utf8mb4"

APP_TIMEZONE=Africa/Tripoli

# Instance folder (runtime data). Default in production on Linux: /var/lib/irs-road/instance
# Locally (Windows/dev) leave it commented → <project>/instance
# INSTANCE_PATH=/var/lib/irs-road/instance

# Uploaded photos (outside the web root, owned by the service user)
UPLOAD_FOLDER=/var/lib/irs-road/uploads
MAX_IMAGE_MB=8
MAX_IMAGES_PER_REPORT=4
MAX_CONTENT_LENGTH_MB=25

# Logs
LOG_DIR=/var/log/irs-road
LOG_LEVEL=INFO

# Rate limiting storage. memory:// is per-worker; use Redis to share limits between workers.
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/3

# Web Push (generate with:  flask vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:it@example.ly

# ---- E-mail (agency mail server: Postfix + PostfixAdmin, mail.iroad.ly) ----
# Existing PostfixAdmin mailbox noreply@iroad.ly + authenticated submission (587, STARTTLS, Dovecot SASL).
MAIL_SERVER=mail.iroad.ly
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=noreply@iroad.ly
MAIL_PASSWORD=CHANGE_ME_MAILBOX_PASSWORD
# MUST be the same mailbox (or an alias it owns) — PostfixAdmin usually rejects other senders
MAIL_FROM=noreply@iroad.ly
MAIL_FROM_NAME="الطريق الدولي ليبيا - International Road Libya"
# Optional: where citizens' replies should go (empty = replies go to MAIL_FROM)
MAIL_REPLY_TO=
MAIL_VERIFY_TLS=true
MAIL_TIMEOUT=20
# Public address of the site (used for links/logo in e-mails sent from the command line)
APP_BASE_URL=https://iroad.ly
# Alternative (same server, no password): local Postfix relay
# MAIL_SERVER=localhost
# MAIL_PORT=25
# MAIL_USE_TLS=false
# MAIL_USERNAME=
# MAIL_PASSWORD=
# Alternative: SMTPS  →  MAIL_PORT=465  MAIL_USE_SSL=true  MAIL_USE_TLS=false

# Map tiles (respect the OSM tile usage policy; use a commercial/self-hosted tile server for heavy traffic)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
