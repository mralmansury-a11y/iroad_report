# ------------------------------------------------------------------
# International Road Services – Libya · environment configuration
# Copy to /etc/irs-road/irs-road.env (production) or .env (local),
# then: chmod 640 and chown root:irsroad. NEVER commit the real file.
# ------------------------------------------------------------------

# development | production   (testing is used only by pytest)
FLASK_CONFIG=production
FLASK_APP=wsgi.py

# python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=change-me

# MariaDB — dedicated user with privileges on this database ONLY (never root)
DATABASE_URL="mysql+pymysql://irs_app:CHANGE_ME_STRONG_PASSWORD@localhost/irs_road?charset=utf8mb4"
# Unix socket alternative (no TCP):
# DATABASE_URL="mysql+pymysql://irs_app:PASSWORD@localhost/irs_road?unix_socket=/run/mysqld/mysqld.sock&charset=utf8mb4"

APP_TIMEZONE=Africa/Tripoli

# Instance folder (runtime data). Default in production on Linux: /var/lib/irs-road/instance
# Locally (Windows/dev) leave it commented → <project>/instance
# INSTANCE_PATH=/var/lib/irs-road/instance

# Uploaded photos (outside the web root, owned by the service user)
UPLOAD_FOLDER=/var/lib/irs-road/uploads
MAX_IMAGE_MB=8
MAX_IMAGES_PER_REPORT=4
MAX_CONTENT_LENGTH_MB=25

# Logs
LOG_DIR=/var/log/irs-road
LOG_LEVEL=INFO

# Rate limiting storage. memory:// is per-worker; use Redis to share limits between workers.
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/3

# Web Push (generate with:  flask vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:it@example.ly

# SMTP for password reset (existing Postfix on the server can be used: localhost:25/587)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.ly

# Map tiles (respect the OSM tile usage policy; use a commercial/self-hosted tile server for heavy traffic)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
